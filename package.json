    "@types/react-dom": "^19.2.3",
    "babel-loader": "^10.1.1",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "path": "^0.12.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "commit-and-tag-version": "^13.1.2",
